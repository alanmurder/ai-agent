# Environment Variables Template
# Copy to .env and fill in your values

# Deployment Mode
DEPLOY_MODE=local

# Model Configuration
MODEL_PROVIDER=deepseek
MODEL_API_KEY=your-deepseek-api-key-here

# Fallback model keys (optional)
ZHIPU_API_KEY=
QWEN_API_KEY=
BAIDU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/aiagent
REDIS_URL=redis://localhost:6379/0

# Gateway Configuration
WEB_PORT=8080
GATEWAY_PORT=18789

# WeChat Enterprise (optional)
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=

# DingTalk (optional)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# Feishu (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Heartbeat
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=5m